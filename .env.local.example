# ── Database (required) ─────────────────────────────────────────────────────
# SQLite by default — no separate database server needed. This backs user
# accounts, sessions, daily AI usage limits, and admin settings.
DATABASE_URL="file:./dev.db"

# ── Auth (required for sign-in, the AI tools, and /admin) ──────────────────
# Generate a secret with: openssl rand -base64 32
# This one stays in .env — it's what encrypts session cookies, so it can't
# live in the admin-editable settings (you'd need a valid session to change
# it, but changing it invalidates every session, including your own).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client, used for "Sign in with Google" (and, once signed in,
# also powers the Google Drive file picker — see below, same client ID).
#   1. https://console.cloud.google.com → create/select a project
#   2. APIs & Services → OAuth consent screen → set it up (External is fine)
#   3. Credentials → OAuth 2.0 Client ID (type: Web application)
#      → Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#        (and https://yourdomain.com/api/auth/callback/google in production)
# These two bootstrap the very first sign-in. The first person to sign in
# becomes the site admin automatically and can rotate these later from
# /admin → Configuration without a redeploy.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Drive import (optional, admin-configurable after first login) ───
# Lets people pick a file straight from Google Drive instead of only local
# upload — the button appears automatically on every tool's file picker
# once these are set (reuses GOOGLE_CLIENT_ID above).
#   1. Same Google Cloud project as above → enable the "Google Picker API"
#      and "Google Drive API"
#   2. Credentials → API key → restrict it to the Picker API
#   3. Authorized JavaScript origins on the OAuth client → add your domain
#      (and http://localhost:3000 for local dev)
NEXT_PUBLIC_GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_APP_ID=000000000000

# ── AI tools (Summarize PDF, Ask your PDF, Translate PDF, AI HTML/PDF) ─────
# Get a key at https://console.anthropic.com/settings/keys
# Admin-configurable after first login (/admin → Configuration). Everything
# else in the app works with no key and no sign-in at all — these four
# tools are the only ones that need this, and are rate-limited per plan
# (see PRO_PLAN_PRICE_INR etc. below and /admin → Pricing).
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Payments / Pro plan (optional) ──────────────────────────────────────────
# Get these at https://dashboard.razorpay.com → Settings → API Keys.
# Without them, /pricing still shows the plans but "Upgrade" errors out
# instead of opening checkout — everything else in the app is unaffected.
#   1. Settings → API Keys → generate a Key ID + Key Secret (use test mode
#      keys while developing — Razorpay test mode needs no real payment).
#   2. Settings → Webhooks → Add New Webhook:
#        URL: https://yourdomain.com/api/razorpay/webhook
#              (http://localhost:3000/api/razorpay/webhook won't be
#               reachable from Razorpay — use a tunnel like ngrok for
#               local webhook testing, or just rely on the checkout
#               callback in dev, which grants access without waiting
#               for the webhook)
#        Active events: subscription.charged, subscription.halted,
#              payment.failed, subscription.cancelled
#        Set a secret — copy it into RAZORPAY_WEBHOOK_SECRET below.
# All admin-configurable after first login (/admin → Configuration and
# /admin → Pricing, the latter for the price itself and the per-plan AI
# limits). The app creates its own Razorpay Plan automatically the first
# time someone upgrades — no need to create one by hand in the dashboard.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Contact page + Feedback button) ──────────────────────────────────
# Get a key at https://resend.com — free tier available.
RESEND_API_KEY=re_xxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=PDFCure <onboarding@resend.dev>

# ── Google AdSense (optional) ───────────────────────────────────────────────
# Get these at https://www.google.com/adsense. Leave blank to stay ad-free.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_HOME=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=0987654321

# Set to true to preview placeholder ad boxes in the real UI with no
# AdSense account needed. Turn off before going live.
NEXT_PUBLIC_ADS_DEMO_MODE=false

# ── Google Analytics (optional) ─────────────────────────────────────────────
# Get this at https://analytics.google.com (GA4 property → Data Streams).
# Tracks page views on every route change, plus tool_success/tool_error
# events and uncaught JS errors. Leave blank for zero tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

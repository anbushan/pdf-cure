// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth.js / Auth.js Prisma adapter shape) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  /// "free" or "pro" — see lib/plan.ts for the limits each implies.
  plan                   String    @default("free")
  planExpiresAt          DateTime?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?   @unique

  accounts          Account[]
  sessions          Session[]
  aiUsage           AiUsage[]
  payments          Payment[]
  notificationReads NotificationRead[]
  activities        UserActivity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App-specific ---

/// One row per successful AI call. Quota is enforced by counting rows for
/// (userId, usedOn [, feature]) at request time — see lib/aiUsage.ts. Free
/// accounts are capped by a total across every feature; Pro accounts are
/// capped per feature, so this can't be a single unique row per user/day
/// the way it could when there was only one tier.
model AiUsage {
  id      String   @id @default(cuid())
  userId  String
  feature String
  usedOn  String // YYYY-MM-DD (UTC)
  usedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedOn])
}

/// Admin-editable key/value settings that override env vars at runtime
/// (e.g. API keys, OAuth credentials, AdSense/GA IDs) — read through
/// lib/settings.ts, which falls back to process.env when unset.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Submissions from the feedback widget (components/FeedbackButton.tsx).
/// Email is optional — feedback doesn't require one. Saved here as the
/// source of truth for the admin Feedback tab; emailing it out (see
/// lib/sendEmail.ts) is best-effort on top of that, not a replacement.
model Feedback {
  id        String   @id @default(cuid())
  type      String
  message   String
  email     String?
  page      String?
  createdAt DateTime @default(now())
}

/// One row per Razorpay payment event (subscription charge, one-off
/// failure, etc.) — written from both the checkout-success verify call
/// and the webhook, so it's the source of truth for the admin Payments
/// tab even if a user closes the tab mid-checkout and only the webhook
/// fires.
model Payment {
  id                     String   @id @default(cuid())
  userId                 String
  razorpayPaymentId      String?  @unique
  razorpayOrderId        String?
  razorpaySubscriptionId String?
  amount                 Int // smallest currency unit (paise for INR)
  currency               String   @default("INR")
  status                 String // created | authorized | captured | failed | refunded
  plan                   String   @default("pro")
  notes                  String? // free-text, e.g. the raw event type for debugging
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// A "Scan to PDF" pairing session (components: app/tools/scan-to-pdf,
/// app/scan/[id]). The id itself is the unguessable token embedded in the
/// QR code URL — anyone who scans it can upload to this session, which is
/// why sessions are short-lived (see EXPIRY_MINUTES in the scan-session
/// API routes) and images are deleted as soon as the desktop side has
/// fetched them. No user account is required, matching the rest of the
/// site's editing tools.
model ScanSession {
  id        String   @id
  status    String   @default("waiting") // waiting | connected | completed
  createdAt DateTime @default(now())
  expiresAt DateTime

  images ScanImage[]
}

model ScanImage {
  id        String   @id @default(cuid())
  sessionId String
  data      Bytes
  order     Int
  createdAt DateTime @default(now())

  session ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/// Trail of admin-relevant actions (settings/pricing changes, admin
/// sign-ins, admin grants) — see lib/auditLog.ts. Not a full accounting of
/// every request in the app, just the actions that change shared
/// configuration or touch access control, which is what an admin actually
/// needs to be able to answer "who changed this, and when."
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorName  String?
  action     String
  target     String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/// Admin-authored announcements shown to signed-in users (a bell menu in
/// the header — see components/NotificationBell.tsx). `active` lets an
/// admin unpublish one without deleting its history; per-user read state
/// lives in NotificationRead rather than on the notification itself, since
/// "read" is inherently per-viewer.
model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("info") // info | success | warning
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads NotificationRead[]

  @@index([active, createdAt])
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

/// Admin-configurable pricing tiers shown on /pricing — see lib/plans.ts
/// (which lazily seeds Free/Pro rows the first time this table is read
/// empty) and app/pricing/PricingClient.tsx (which renders these
/// dynamically instead of two hardcoded cards).
///
/// `cta` controls the card's button: "free" is the no-signup starting
/// tier, "checkout" wires to the existing single-price Razorpay flow
/// (lib/razorpay.ts / Settings.PRO_PLAN_PRICE_INR), and "disabled" shows
/// a non-clickable "Coming soon" button. Only one plan should be
/// "checkout" today — enforcement (the actual AI daily limit and
/// Razorpay charge) still comes from the free/pro Settings values, not
/// from `dailyAiLimit` here, until multi-tier billing is built; that
/// field is display copy an admin should keep in sync by hand for now.
model Plan {
  id           String   @id @default(cuid())
  name         String
  description  String
  priceInr     Int      @default(0)
  dailyAiLimit Int      @default(0)
  features     String // JSON-encoded string[] of bullet points
  cta          String   @default("disabled") // free | checkout | disabled
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One row per completed tool run, logged from components/ResultPanel.tsx
/// whenever a signed-in user finishes any of the non-AI tools (compress,
/// merge, sign, etc. — every tool that renders a ResultPanel). Only the
/// tool slug and timestamp are stored, never the file itself or its name
/// — this powers "My Downloads" / "Recent Activity" under /account
/// without changing the app's actual privacy model, since the file
/// still never leaves the browser. AI tool usage is tracked separately
/// in AiUsage and merged into the same feed at read time.
model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  tool      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

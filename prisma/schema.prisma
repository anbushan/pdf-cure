// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth.js / Auth.js Prisma adapter shape) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  /// "free" or "pro" — see lib/plan.ts for the limits each implies.
  plan                   String    @default("free")
  planExpiresAt          DateTime?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?   @unique

  accounts Account[]
  sessions Session[]
  aiUsage  AiUsage[]
  payments Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App-specific ---

/// One row per successful AI call. Quota is enforced by counting rows for
/// (userId, usedOn [, feature]) at request time — see lib/aiUsage.ts. Free
/// accounts are capped by a total across every feature; Pro accounts are
/// capped per feature, so this can't be a single unique row per user/day
/// the way it could when there was only one tier.
model AiUsage {
  id      String   @id @default(cuid())
  userId  String
  feature String
  usedOn  String // YYYY-MM-DD (UTC)
  usedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedOn])
}

/// Admin-editable key/value settings that override env vars at runtime
/// (e.g. API keys, OAuth credentials, AdSense/GA IDs) — read through
/// lib/settings.ts, which falls back to process.env when unset.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Submissions from the feedback widget (components/FeedbackButton.tsx).
/// Email is optional — feedback doesn't require one. Saved here as the
/// source of truth for the admin Feedback tab; emailing it out (see
/// lib/sendEmail.ts) is best-effort on top of that, not a replacement.
model Feedback {
  id        String   @id @default(cuid())
  type      String
  message   String
  email     String?
  page      String?
  createdAt DateTime @default(now())
}

/// One row per Razorpay payment event (subscription charge, one-off
/// failure, etc.) — written from both the checkout-success verify call
/// and the webhook, so it's the source of truth for the admin Payments
/// tab even if a user closes the tab mid-checkout and only the webhook
/// fires.
model Payment {
  id                     String   @id @default(cuid())
  userId                 String
  razorpayPaymentId      String?  @unique
  razorpayOrderId        String?
  razorpaySubscriptionId String?
  amount                 Int // smallest currency unit (paise for INR)
  currency               String   @default("INR")
  status                 String // created | authorized | captured | failed | refunded
  plan                   String   @default("pro")
  notes                  String? // free-text, e.g. the raw event type for debugging
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// A "Scan to PDF" pairing session (components: app/tools/scan-to-pdf,
/// app/scan/[id]). The id itself is the unguessable token embedded in the
/// QR code URL — anyone who scans it can upload to this session, which is
/// why sessions are short-lived (see EXPIRY_MINUTES in the scan-session
/// API routes) and images are deleted as soon as the desktop side has
/// fetched them. No user account is required, matching the rest of the
/// site's editing tools.
model ScanSession {
  id        String   @id
  status    String   @default("waiting") // waiting | connected | completed
  createdAt DateTime @default(now())
  expiresAt DateTime

  images ScanImage[]
}

model ScanImage {
  id        String   @id @default(cuid())
  sessionId String
  data      Bytes
  order     Int
  createdAt DateTime @default(now())

  session ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/// Trail of admin-relevant actions (settings/pricing changes, admin
/// sign-ins, admin grants) — see lib/auditLog.ts. Not a full accounting of
/// every request in the app, just the actions that change shared
/// configuration or touch access control, which is what an admin actually
/// needs to be able to answer "who changed this, and when."
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorName  String?
  action     String
  target     String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
